# Production Environment Variables for Motabari3 Blood Bank System
# Copy this file to .env and update the values for your production environment

# Backend API URL (change to your production domain)
VITE_API_URL=http://localhost:3001

# Frontend URL (change to your production domain)
VITE_FRONTEND_URL=http://localhost:3000

# MongoDB Connection (will be overridden by Docker Compose)
CONNECTION_STRING=mongodb://admin:password123@mongodb:27017/hemocelldb?authSource=admin

# JWT Secret (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-make-it-very-long-and-random

# Email Service (Resend API)
RESEND_API_KEY=your-resend-api-key-here

# Stripe Configuration (if using payments)
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_SECRET_KEY=your-stripe-secret-key

# Node Environment
NODE_ENV=production

# Server Port
PORT=3001

# Frontend URL for CORS and email links
FRONTEND_URL=localhost:3000

# Security Settings
SESSION_SECRET=your-session-secret-here

# MongoDB Settings (if using external MongoDB)
MONGO_USERNAME=admin
MONGO_PASSWORD=password123
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE=hemocelldb

# Admin Credentials
ADMIN_EMAIL=admin@motabari3.com
ADMIN_PASSWORD=Admin@123

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Settings
MAX_FILE_SIZE=5242880

# Logging Level
LOG_LEVEL=info